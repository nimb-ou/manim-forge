<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.manimforge.supervisor</string>
  <key>ProgramArguments</key>
  <array>
    <string>/usr/bin/caffeinate</string>
    <string>-i</string>
    <string>--</string>
    <string>/Users/nimitjain/Desktop/My Mac/Projects/manim-forge/.venv/bin/python</string>
    <string>-u</string>
    <string>/Users/nimitjain/Desktop/My Mac/Projects/manim-forge/scripts/supervisor.py</string>
    <string>--once</string>
  </array>
  <key>WorkingDirectory</key><string>/Users/nimitjain/Desktop/My Mac/Projects/manim-forge</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/Library/TeX/texbin:/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    <key>PYTHONUNBUFFERED</key><string>1</string>
    <key>PYTHONPATH</key><string>/Users/nimitjain/Desktop/My Mac/Projects/manim-forge</string>
  </dict>
  <key>RunAtLoad</key><true/>
  <!-- KeepAlive, not StartInterval. One process per sweep was the right
       instinct and the wrong mechanism: launchd ran the job once at load
       and not again for 43 minutes, because it defers interval jobs. So the
       loop is back, with the two properties it was missing -- each sweep is
       bounded by a 120s alarm and now takes 4.2 seconds, and the process
       retires after twelve sweeps so launchd hands over a fresh one every
       hour. A loop that runs forever is a loop that can wedge forever. -->
  <!-- No sleeping in-process at all. `time.sleep(300)` did not return for
       sixteen minutes on an unloaded machine with the job at nice 0 and
       ProcessType Interactive, which is the third distinct way this
       watchdog has gone quiet while alive.
       So: sweep once, exit, and let KeepAlive plus ThrottleInterval supply
       the cadence. launchd restarting an exited job after 300 seconds is
       the one timing mechanism here that has not failed, and a process that
       only ever runs for four seconds has nowhere to wedge. -->
  <key>KeepAlive</key><true/>
  <key>ThrottleInterval</key><integer>300</integer>
  <key>StandardOutPath</key><string>/Users/nimitjain/Desktop/My Mac/Projects/manim-forge/data/supervisor/launchd.log</string>
  <key>StandardErrorPath</key><string>/Users/nimitjain/Desktop/My Mac/Projects/manim-forge/data/supervisor/launchd.log</string>
  <!-- Interactive, not Background, and not niced.
       ProcessType=Background tells macOS this job is throttleable, and the
       machine is running MLX inference at full tilt, so its timers were
       coalesced hard: one sweep at 17:54 and nothing for the next 27
       minutes, the process alive at zero CPU the whole time. A watchdog
       that the OS is free to defer indefinitely is not a watchdog.
       A 4.2-second sweep every five minutes does not need to be
       throttleable. -->
  <key>ProcessType</key><string>Interactive</string>
</dict>
</plist>
